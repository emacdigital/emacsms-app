<resources>
    <style name="Theme.MultiSMS" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#1976D2</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>

    <!-- Écran de démarrage (splash) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MultiSMS</item>
    </style>
</resources>
